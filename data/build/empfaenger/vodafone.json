"lobby_zuwendungen": [
{
"geber": "BMI",
"epl": "06",
"von": 20001,
"bis": 30000,
"zweck": "ADELE – Automatisierter Drohneneinsatz aus der Leitstelle Ziel des Förderprojekts ist die Integration von Drohneneinsätzen in die Standardabläufe von Behörden und Organisationen mit Sicherheitsaufgaben (BOS), insbesondere Polizei, Feuerwehr und Rettungsdienste. Drohnen wurden automatisiert und rechts- sowie datenschutzkonform direkt aus der Leitstelle zu steuern und deren Echtzeitdaten unmittelbar für die Einsatzkoordination bereitzustellen. Dabei werden moderne 5G-/MCx-Kommunikationstechnologien genutzt, um Lageinformationen bereits vor dem Eintreffen der Einsatzkräfte verfügbar zu machen und so die Einsatzplanung, Sicherheit und Reaktionsgeschwindigkeit deutlich zu verbessern.",
"geschaeftsjahr": "2025"
},
{
"geber": "BMI",
"epl": "06",
"von": 40001,
"bis": 50000,
"zweck": "Hybrid-Eins – Hybridnetz für breitbandige MCX-Einsatzkommunikation BOS Hybrid-Eins ist ein BDBOS-gefördertes Forschungsprojekt zur Kopplung von öffentlichem 4G/5G-Mobilfunk und BOS-Digitalfunk (TETRA) für einsatzkritische Kommunikation. Gemeinsam mit Partnern wie Frequentis, Teamwire und NKMG untersucht Vodafone die Nutzung von MCx-Technologien, um die Digitalisierung und Zukunftsfähigkeit kritischer Infrastrukturen und BOS-Kommunikation voranzutreiben. Vodafone bringt seine Mobilfunkinfrastruktur, Priorisierungsmechanismen und Expertise im Bereich 3GPP-basierter MCx-Lösungen in das Projekt ein.",
"geschaeftsjahr": "2025"
},
{
"geber": "BMDV",
"epl": "12",
"von": 240001,
"bis": 250000,
"zweck": "GINT XT GINT entwickelt und testet gemeinsam mit Bahn und Mobilfunknetzbetreibern eine 5G-basierte Infrastruktur entlang der Schiene zur Verbesserung der Fahrgastkonnektivität und zur Migration auf FRMCS.",
"geschaeftsjahr": "2025"
}
],

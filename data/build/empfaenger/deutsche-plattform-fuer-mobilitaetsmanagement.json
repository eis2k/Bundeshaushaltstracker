"lobby_zuwendungen": [
{
"geber": "Umweltbundesamt",
"epl": "16",
"von": 50001,
"bis": 60000,
"zweck": "Es handelt sich erstens um eine Verbändeförderung für das Projekt \"BMMQualiKom\". Im Rahmen des Projekts entwickelt die DEPOMM einen Lehrgang für Beschäftigte in Kommunalverwaltungen, der Grundlagen, Potenziale und Maßnahmen zu einer strategischen Unterstützung von privaten Betrieben beim betrieblichen Mobilitätsmanagement vermittelt. Die Umsetzung des Lehrgangs soll durch auf Ebene der Bundesländer erfolgen. Ziel ist es, auf diesem Weg Kooperationen von Kommunen und Betrieben für eine nachhaltige Mobilitätswende auf lokaler Ebene anzustoßen und zu befördern. Weiter handelt es sich um eine Förderung für das Projekt \"\"RegionetzeBMM - Aufbau und Unterstützung regionaler Zusammenarbeit für Betriebliches Mobilitätsmanagement\"\".",
"geschaeftsjahr": "2025"
}
],

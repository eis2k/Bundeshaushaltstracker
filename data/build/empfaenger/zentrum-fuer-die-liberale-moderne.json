"zweck": "Institutionelle Förderung aus Mitteln des Bundeshaushaltes",
"geschaeftsjahr": "2025"
},
{
"geber": "Auswärtiges Amt",
"epl": "05",
"von": 290001,
"bis": 300000,
"zweck": "Förderung des Projekts Deutsch-ukrainischer parlamentarischer Dialog, Stärkung des gegenseitigen Verständnisses und Förderung der europäischen Integration der Ukraine: Eine stärkere Integration der Ukraine in den wichtigsten Politikbereichen; Erschaffung einer Plattformen für die ukrainischen demokratischen Akteure und ihre Botschaften; Förderung der Modernisierung der Ukraine durch die Verstärkung der europäischen Integration der Ukraine.",
"geschaeftsjahr": "2025"
},
{
"geber": "Auswärtiges Amt",
"epl": "05",
"von": 150001,
"bis": 160000,
"zweck": "Förderung des Projekts Östliche Partnerschaft Plus Das Projekt Östliche Partnerschaft Plus hat zum Ziel, die Vertreter:innen der Zivilgesellschaft der drei assoziierten Staaten bei der Annäherung an die EU zu unterstützen, indem sie gemeinsam Herausforderungen und Prioritäten in den Bereichen Rechtsstaatlichkeit, Demokratieförderung sowie Energie-und Klimapolitik identifizieren, konkrete Handlungsempfehlungen entwickeln und somit auf die effiziente EU-Integration des Trios hinwirken. Durch den Austausch werden Grundsteine für die langfristige Zusammenarbeit gelegt.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesamt für Migration und Flüchtlinge",
"epl": "06",
"von": 200001,
"bis": 210000,
"zweck": "Förderung des Projekts \"o[s]tklick: Postmigrantische Gesellschaft gestalten\". Das Ziel des Projekts ist die Demokratieförderung innerhalb der russlanddeutschen Community und Stärkung der Debattenkultur.",
"geschaeftsjahr": "2025"
},
{
"geber": "Auswärtiges Amt",
"epl": "05",
"von": 190001,
"bis": 200000,
"zweck": "Projekt \"Politische Wege aus Krieg, Terror und Besatzung im israelisch-palästinensischen Konflikt: Bereitschaft zu einer politischen Lösung fördern und Zwei-Staaten-Lösung neu denken\". Das Ziel des Projekts ist die Beförderung eines politischen Prozesses, um basierend auf dem Konzept der Zwei-Staaten-Lösung das Streben nach palästinensischer Selbstbestimmung mit den Sicherheitsinteressen Israels in Einklang zu bringen und damit den Weg für eine breiter angelegte Friedensordnung im Nahen Osten zu bahnen.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Bildung und Forschung",
"epl": "30",
"von": 290001,
"bis": 300000,
"zweck": "Ziel des Verbundprojekts ist die Herausgabe einer Schriftenreihe zum Thema Liberalismus. Die Reihe sammelt die wichtigsten liberalen Denkgebäude und einschlägigen Argumente von WissenschaftlerInnen und Intellektuellen des 20. und frühen 21. Jahrhunderts, ordnet sie wissenschaftlichen ein und macht Originaltexte sowie Kommentare für die interessierte Öffentlichkeit zugänglich.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundeszentrale für politische Bildung",
"epl": "06",
"von": 30001,
"bis": 40000,
"zweck": "Förderung für das Projekt „Herausforderung Russland – Können Deutschland und Polen ihr gemeinsam begegnen?“.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundeszentrale für politische Bildung",
"epl": "06",
"von": 60001,
"bis": 70000,
"zweck": "Förderung für das Projekt \"Die Ukraine und wir (Ukraine verstehen)\".",
"geschaeftsjahr": "2025"
}
],

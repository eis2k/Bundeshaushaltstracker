"lobby_zuwendungen": [
{
"geber": "Deutsche Gesellschaft für Internationale Zusammenarbeit (GIZ) GmbH",
"epl": "23",
"von": 20001,
"bis": 30000,
"zweck": "Die Förderung der GIZ GmbH ist für Transparency Deutschlands Rolle in der Multi-Stakeholder-Gruppe (MSG) der \"Initiative für Transparenz im rohstoffgewinnenden Sektor\" (D-EITI). In der MSG sind Akteure aus Regierung, Wirtschaft und Zivilgesellschaft vertreten. Sie werden von der Bundesregierung für einen Zeitraum von mindestens zwei Jahren berufen. Aufgabe der MSG ist die Steuerung und Kontrolle der Umsetzung von D-EITI. Dazu gehören unter anderem die Abnahme von Arbeitsplänen und Fortschrittsberichten.",
"geschaeftsjahr": "2025"
}

"lobby_zuwendungen": [
{
"geber": "Engagement Global (Mittel des Bundesministeriums für Entwicklungszusammenarbeit)",
"epl": "23",
"von": 600001,
"bis": 610000,
"zweck": "Projektantrag im Rahmen des Förderprogramms Entwicklungspolitische Bildung aus Mitteln des Bundesministeriums für wirtschaftliche Zusammenarbeit und Entwicklung. Das Projekt leistet Informations- und Bildungsarbeit am Beispiel des Fairen Handels. Das Forum Fairer Handel möchte mit diesem Projekt nachhaltige Konsum- und Produktionsmuster fördern, Debatten zum Fairen Handel qualifizieren und die Bewegung befähigen, politisch aktiv zu werden, um Handel im Sinne der SDG nachhaltiger und fairer zu gestalten.",
"geschaeftsjahr": "2025"
},
{
"geber": "Gesellschaft für Internationale Zusammenarbeit (GIZ)",
"epl": null,
"von": 70001,

"lobby_zuwendungen": [
{
"geber": "Bundesministerium für Forschung, Technologie und Raumfahrt",
"epl": "30",
"von": 450001,
"bis": 460000,
"zweck": "Um auf aktuelle Entwicklungen im Forschungsfeld zu reagieren und Impulse in der Friedens- und Konfliktforschung zu setzen erhält die Deutsche Stiftung Friedensforschung (DSF) finanzielle Unterstützung in ihrem Förderbereich 3: Thematische Förderlinie. Zu spezifischen Themenfeldern, wie Digitalisierung, Klimawandel o.ä. können zusätzliche Forschungs- und Tagungsprojekte beantragt werden. Die ausgeschriebenen Mittel stellen die tatsächlich abgerufene Summe dar.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Forschung, Technologie und Raumfahrt",
"epl": "30",
"von": 1990001,
"bis": 2000000,
"zweck": "Die Zustiftung aus dem Bundeshaushalt ist ein wichtiger Beitrag zur strategischen Weiterentwicklung der DSF als Einrichtung der Forschungsförderung für die Friedens- und Konfliktforschung, wie sie vom Wissenschaftsrat empfohlen wurde. Sie ermöglicht der Stiftung eine solide mittelfristige Finanzplanung für ihre Förderleistungen. Diese sind darauf ausgerichtet, die Innovationsfähigkeit des Forschungsfeldes zu stärken, Wissensbestände zusammenzuführen und die Ergebnisse für den Austausch mit Gesellschaft und Politik aufzubereiten.",
"geschaeftsjahr": "2025"
}
],

{
"geber": "Bundesministerium für Bildung, Familie, Senioren, Frauen und Jugend (BMFSFJ)",
"epl": "17",
"von": 290001,
"bis": 300000,
"zweck": "Projektförderung \"Die Strukturen der Bundesarbeitsgemeinschaft und der Freiwilligenagenturen resilient und nachhaltig gestalten Bund-Länder-Vernetzung, Thementage, Arbeitsforen, Qualitätsmanagementsystem, Fortbildungen, Hospitationsprogramm, Öffentlichkeitsarbeit.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Bildung, Familie, Senioren, Frauen und Jugend (BMFSFJ)",
"epl": "17",
"von": 560001,
"bis": 570000,
"zweck": "Projekt \"Niedrigschwellige Patenschaften: sich begegnen, austauschen und voneinander lernen\". Im Rahmen des Programms \"Menschen stärken Menschen\". 22 Freiwilligenagenturen vor Ort stifteten insgesamt 1990 niedrigschwellige Impulspatenschaften für sozialbenachteiligte Gruppen. Die bagfa begleitete und koordinierte die Aktivitäten auf Bundesebene.",
"geschaeftsjahr": "2025"
},
{
"geber": "Deutsche Stiftung für Engagement und Ehrenamt",
"epl": "17",
"von": 30001,
"bis": 40000,
"zweck": "In dem Projekt „Engagementstrukturen wehrhaft und stark machen: Schutz und Prävention in der Alltagspraxis von Freiwilligen-agenturen verankern“ führte die bagfa eine Umfrage unter den Freiwillligenagenturen durch und baute eine Online-Themenwelt \"Schutz und Demokratie\" auf.",
"geschaeftsjahr": "2025"
}
],

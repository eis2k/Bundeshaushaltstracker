"lobby_zuwendungen": [
{
"geber": "Bundesministerium für Bildung, Familie, Senioren, Frauen und Jugend",
"epl": "17",
"von": 450001,
"bis": 460000,
"zweck": "Die National Coalition Deutschland wurde im Jahr 2025 aus Mitteln des Kinder- und Jugendplans des Bundes gefördert, um Impulse zur Umsetzung der UN-Kinderrechtskonvention zu initiieren, Kinderrechte in Deutschland bekannt zu machen und das zivilgesellschaftliche Monitoring zur Umsetzung der Kinderrechtskonvention im Follow-UP Verfahren vor dem UN-Ausschuss für die Rechte des Kindes zu begleiten.",
"geschaeftsjahr": "2025"
},
{
"geber": "SOS Kinderdorf Weltweit",
"epl": null,
"von": 60001,
"bis": 70000,
"zweck": "Im Dezember 2025 wurde der Projektantrag, „Mitreden. Mitgestalten. Mitentscheiden. Kinder- und Jugendbeteiligung im Kinderrechte-Monitoring“ den das Netzwerk bei SOS-Kinderdörfer weltweit gestellt hat, positiv bewilligt. Im Rahmen des Projekts wird eine dauerhafte Kinder- und Jugendbeteiligung im Monitoring der Kinderrechte aufgebaut. Gefördert wird die Vernetzung von Fachkräften in einem Themennetzwerk und eine Kampagne zum Thema Partizipation.",
"geschaeftsjahr": "2025"
}
],

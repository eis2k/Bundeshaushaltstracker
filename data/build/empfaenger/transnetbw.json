"haushalt": {
"titel": []
},
"lobby_zuwendungen": [
{
"geber": "Bundesministerium für Wirtschaft und Klimaschutz",
"epl": "09",
"von": 210001,
"bis": 220000,
"zweck": "Projekt BANULA: Das BANULA-Konzept ist ein ganzheitlicher Ansatz, um energiewirtschaftliche Prozesse im Rahmen der Strombilanzierung mit den kaufmännischen Prozessen rund um Roaming und der Belieferung von ladenden Elektromobilisten zu verbinden und zu Gunsten der Endkunden und der Strommarktrollen effizienter zu gestalten. Unser Ansatz ermöglicht eine bilanziell korrekte Trennung zwischen den Rollen Verteilnetzbetreiber, Ladeinfrastrukturbetreiber und Mobilitätsanbieter.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Wirtschaft und Klimaschutz",
"epl": "09",
"von": 60001,
"bis": 70000,
"zweck": "Projekt PROGRESS: Im Projekt PROGRESS werden kurative Maßnahmen zur Entlastung in Höchst- und Hochspannungsnetzen (HöS / HS) erprobt. Unter Beteiligung eines Leitsystemherstellers, Übertragungs- und Verteilnetzbetreibern sowie akademischen Partnern wird die Umsetzung kurativer Maßnahmen innerhalb von Feldtestvorhaben in realen Leitsystemumgebungen erprobt.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Wirtschaft und Klimaschutz",
"epl": "09",
"von": 20001,
"bis": 30000,
"zweck": "Das Forschungsprojekt RESILIENT zielt darauf ab, die Energiesystemplanung widerstandsfähiger gegen Unsicherheiten zu gestalten. TransnetBW entwickelt ein Planungswerkzeug, das nachhaltige und robuste Energieinfrastrukturen ermöglicht, indem das Energiesystemmodell PyPSA-Eur zu einer stochastischen Optimierung weiterentwickelt wird. Dies soll sicherstellen, dass das Energiesystem für verschiedene mögliche Entwicklungen optimal gerüstet ist. Das Projekt wird vom Fachbereich Digitaler Wandel in Energiesystemen der TU Berlin geleitet und durch das Bundesministerium für Wirtschaft und Klimaschutz sowie die CET Partnership Initiative der EU gefördert. Ziel ist es, internationale Maßstäbe in der Energiesystemplanung zu setzen und einen wesentlichen Beitrag zu einem sicheren, klimaneutralen Stromsystem zu leisten.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Wirtschaft und Energie",
"epl": "09",
"von": 10001,
"bis": 20000,
"zweck": "Das Forschungsprojekt SysStab 2030 befasst sich mit den zunehmenden Herausforderungen der elektrischen Systemstabilität in einem sich grundlegend wandelnden Stromsystem. Vor dem Hintergrund steigender Transite, höherer Netzauslastung und eines wachsenden Anteils stromrichterbasierter Erzeuger untersucht das Projekt die Auswirkungen auf zentrale Stabilitätsaspekte wie Spannungs‑, Frequenz‑ und transiente Stabilität sowie Reglerinteraktionen. Ziel ist es, zukünftige Systembedarfe systematisch zu analysieren und Optionen zur Bereitstellung notwendiger stabilisierender Beiträge durch Erzeugungs‑, Verbraucher‑, Speicher‑ und Netzbetriebsmittel zu identifizieren. Dabei werden sowohl technische Mindestanforderungen als auch marktliche Beschaffungsansätze betrachtet. Ein besonderer Fokus liegt auf dem Einsatz netzbildender Anlagen, die künftig mehrere Systemfunktionen bündeln und einen wesentlichen Beitrag zur sicheren Integration eines vollständig erneuerbaren Stromsystems leisten können.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Wirtschaft und Energie",
"epl": "09",
"von": 110001,
"bis": 120000,
"zweck": "Das Forschungsprojekt DataFleX untersucht die digitale und marktliche Integration dezentraler Flexibilitäten aus den Sektoren Strom, Wärme und Verkehr in das Energiesystem. Ziel ist es, durch einen sektorenübergreifenden Datenaustausch bislang getrennte Datenökosysteme zu verknüpfen und dezentrale Verbraucher und Speicher wie Elektrofahrzeuge, Wärmepumpen und Heimspeicher systemrelevant nutzbar zu machen. Im Mittelpunkt stehen die Entwicklung und Erprobung geeigneter Marktmechanismen zur wirtschaftlichen Aktivierung dieser Flexibilitäten sowie deren Einsatz zur Netzstabilisierung, insbesondere im Redispatch. Die Ansätze werden in Modellregionen innerhalb der Regelzonen von TransnetBW und TenneT Germany unter realen Bedingungen erprobt und vom Bundesministerium für Wirtschaft und Energie gefördert.",
"geschaeftsjahr": "2025"
}
],

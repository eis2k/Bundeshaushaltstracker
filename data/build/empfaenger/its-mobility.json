"lobby_zuwendungen": [
{
"geber": "Bundesministerium für Wirtschaft und Klimaschutz",
"epl": "09",
"von": 190001,
"bis": 200000,
"zweck": "Der Transformations-Hub TASTE verfolgt langfristig die Ziele, Softwareentwicklung (SWE) als strategisches First-Level-Topic im Automobilsektor zu etablieren und eine branchenweite SWE-Kultur aufzubauen. Im Zeitraum des Vorhabens soll der Hub als Inkubator und Multiplikator für moderne SWE-Methoden wirken und die Kompetenzen des Automobilsektors zur Integration von Software entlang der Wertschöpfungskette und des Produktlebenszyklus stärken.",
"geschaeftsjahr": "2024"
},
{
"geber": "Bundesministerium für Wirtschaft und Klimaschutz",
"epl": "09",
"von": 130001,
"bis": 140000,
"zweck": "Primäres Ziel des Transformations-Hubs MIAMy (Accelerate Market Introduction of Autonomous Mobility) ist die Beschleunigung der Markteinführung zukünftiger Fahrzeugkonzepte im Bereich des vernetzten und sicheren autonomen Fahrens und innovativer Mobilitätsdienstleistungen durch systematisches Aufbereiten von Methoden und Werkzeugen durch wissenschaftliche Erkenntnisse sowie der Bereitstellung relevanter Daten und Dienste.",
"geschaeftsjahr": "2024"
}

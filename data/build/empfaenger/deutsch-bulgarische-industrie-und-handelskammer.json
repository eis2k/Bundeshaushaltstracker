"lobby_zuwendungen": [
{
"geber": "Bundesministerium für Wirtschaft und Energie",
"epl": "09",
"von": 460001,
"bis": 470000,
"zweck": "Für die Wahrnehmigung von Aufgaben der Außenwirtschafdförderung im öffentlichen Interesse erhält die AHK Bulgarien eine Zuwendung des Bundesministeriums für Wirtschaft und Energie (BMWE) im Rahmen der globalen Förderung des weltweiten Netzes der Auslandshandelskammern (AHK).",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Wirtschaft und Energie",
"epl": "09",
"von": 50001,
"bis": 60000,
"zweck": "Zuwendung zur Unterhaltung des GTAI Büros in Bulgarien. Die GTAI ist in den Büroräumen der AHK angesiedelt. Durch die Zuwendung werden Miete, Administrationskosten und lokal Angestellte der GTAI finanziert.",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium des Auswärtigen",
"epl": null,
"von": 10001,
"bis": 20000,
"zweck": "Ziele des Projekts Strukturwandelgespräche waren die Sensibilisierung und der Know-how-Transfer zum Strukturwandel in den Kohlegebieten Bulgariens durch die Durchführung einer Informationsveranstaltung in der Region Stara Zagora am 2. Dezember 2025. Im Rahmen des Diskussionsforums „Frauen in der regionalen Transformation: Wege zu einem gerechten Übergang“ in Stara Zagora wurde der öffentliche Dialog über die Rolle der Frauen im Strukturwandel gefördert. Die Veranstaltung trug zu einer bewussteren und sozial ausgewogeneren Gestaltung des Transformationsprozesses bei und unterstützte den Austausch von Erfahrungen und Perspektiven zwischen den beteiligten Akteurinnen und Akteuren. Das Projekt hat die Deutsche Botschaft in Sofia initiiert und finanziert.",
"geschaeftsjahr": "2025"
}
],

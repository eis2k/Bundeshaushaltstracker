"lobby_zuwendungen": [
{
"geber": "KOMATRA Konsortium - Kompetenzzentrum Arbeitsforschung",
"epl": null,
"von": 10001,
"bis": 20000,
"zweck": "KOMATRA ist ein öffentlich gefördertes Kompetenzzentrum, das u.a. Unternehmen der Medizintechnik bei nachhaltiger Transformation, Arbeitsgestaltung und Nachhaltigkeitsthemen unterstützt. Das konkrete Forschungs- und Entwicklungsprojekt wird durch das Bundesministerium für Forschung, Technologie und Raumfahrt (BMFTR) im Programm „Zukunft der Wertschöpfung – Forschung zu Produktion, Dienstleistung und Arbeit“ gefördert und vom Projektträger Karlsruhe (PTKA) betreut. Als Unternehmenspartner im Projekt KOMATRA waren wir im Projektjahr 2025 an folgenden allgemeinen Projektergebnissen beteiligt: Teilnahme an Interviews „use case journeys”, zur vertieften Erforschung der unternehmerischen Transformationspfade, umfangreiche Maßnahmeerprobungen im Bereich werteorientiertes Arbeiten (Konzeption der Maßnahmen – Durchführung in use cases) sowie Teilnahme am Fachkongress in Koblenz und verschiedenen Workshopreihen mit dem Ziel, die Erkenntnisse in operative Strukturen zu integrieren.",
"geschaeftsjahr": "2025"
}
],

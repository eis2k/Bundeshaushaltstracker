"lobby_zuwendungen": [
{
"geber": "DLR Projektträger",
"epl": "30",
"von": 200001,
"bis": 210000,
"zweck": "Unit-e2 (Im Projekt unIT-e² treiben 31 Unternehmen und Forschungsinstitute die optimale Integration der Elektromobilität in das Energiesystem voran. Im Rahmen von vier sogenannten \"Clustern\" finden mehrere Feldversuche sowie Laboruntersuchungen statt. Begleitet werden die Praxisvorhaben von den Teilprojekten Forschung und Grid, welche das Konsortium bei übergreifenden Themen unterstützen und mit eigenen Forschungsvorhaben begleiten.)",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Wirtschaft und Energie",
"epl": "09",
"von": 40001,
"bis": 50000,
"zweck": "SuperLink: Im Projekt soll das Konzept für eine 12 km lange, supraleitende, 500 MVA Kabelverbindung quer durch München erarbeitet und alle wichtigen Komponenten entwickelt, getestet und Typ-geprüft werden.",
"geschaeftsjahr": "2025"
},
{
"geber": "Projektträger Jülich (PtJ)",
"epl": "30",
"von": 80001,
"bis": 90000,
"zweck": "F&E-Projekt VESTA - Verbundvorhaben: VESTA - Very-High-Temperature Heat Aquifer Storage; Teilvorhaben: VESTA-Malm - Hochtemperatur Speicherung im Malm & Performance-Konzepte. Das mehrjährige Forschungs- und Entwicklungsprojekt VESTA Malm untersucht die Möglichkeiten von Hochtemperatur-Aquiferwärmespeichern im geothermischen genutzten Malm-Aquifer des bayerischen Molassebeckens.",
"geschaeftsjahr": "2025"
},
{
"geber": "Projektträger Jülich (PtJ)",
"epl": "30",
"von": 1,
"bis": 10000,
"zweck": "Verbundvorhaben: GFK-Monitor - Entwicklung eines ganzheitlichen Monitorings mit Unterstützung der Glasfaserkabeltechnologie und Tracertechnik zur Verbesserung der Systemintegrität von Geothermieanlagen; Teilvorhaben: Entwicklungen zur Systemintegrität in der Geothermieproduktion",
"geschaeftsjahr": "2025"
},
{
"geber": "Bundesministerium für Wirtschaft und Energie",
"epl": "09",
"von": 160001,
"bis": 170000,
"zweck": "EnEff:Wärme: En-Eff_Netzregelung Energieeffizienzbasierte Regelung von dezentral gespeisten Wärme- und Kältenetzen unter Berücksichtigung von Lebensdauereffekten; Teilvorhaben: Realisierung und Erprobung. Als Teilprojekt wird Smart Heat Grid 2.0 durchgeführt. Die Wärmeabnahme der Kunden als weitere Stellgröße ist sehr interessant für eine energieeffiziente und lebensdauerschonende Netzregelung.",
"geschaeftsjahr": "2025"
},
{
"geber": "Projektträger Jülich (PtJ)",
"epl": "30",
"von": 650001,
"bis": 660000,
"zweck": "Verbundvorhaben: GIGA-M - Großräumige Integrierte Gesamt-Analyse des tiefengeothermischen Potentials und seiner synergetischen Nutzung im Großraum München, Teilprojekt: SWM: Reservoirmanagement, 3Dseismische Erkundung und Interpretation, Extended Reach Drilling-Konzept, Abbau Nicht-Technischer Barrieren",
"geschaeftsjahr": "2025"
},
{
"geber": "Projektträger Jülich (PtJ)",
"epl": "30",
"von": 50001,
"bis": 60000,
"zweck": "F&E-Projekt ESM-Scaling; Verbundvorhaben ESM Scaling / EvaM 2.0: EvA-M2 - Anwendung von umweltfreundlichen Inhibitoren und CO2 zur Vermeidung von Karbonatsausfällungen in der tiefen Geothermie des Bayerischen Molassebeckens; Teilverfahren: Umsetzung Verfahren im Anlagenmaßstab und In-situ Tests.",
"geschaeftsjahr": "2025"
},
{
"geber": "Projektträger Jülich (PtJ)",
"epl": "30",
"von": 1,
"bis": 10000,
"zweck": "Verbundvorhaben: ANtLiA – ANwendungsbezogene Weiterentwicklung von Tauchkreiselpumpen und Line Shaft Pumpen in geothermischen Anlagen; Teilvorhaben: EveBeKo - Empfehlungen für einen verbesserten Betrieb und verbesserte Komponenten von ESPs.",

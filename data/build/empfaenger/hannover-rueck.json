"lobby_zuwendungen": [
{
"geber": "InsuResilience Solutions Fund (ISF)",
"epl": null,
"von": 10001,
"bis": 20000,
"zweck": "Die Hannover Rück beteiligt sich an Projekten zur Förderung der Resilienz gegen Klimarisiken. Hierbei ist sie Teil eines Projektkonsortiums, das eine neue Risikoabsicherung für Städte in Argentinien gegen Flutgefahren entwickelt. Im Rahmen dieses Projektes hat die Hannover Rück für einen Teil der erbrachten Leistungen eine finanzielle Kompensation aus dem InsuResilience Solutions Fund (ISF) erhalten. Der ISF wurde von der KfW mit Finanzmitteln aus dem Bundesministerium für wirtschaftliche Zusammenarbeit und Entwicklung (BMZ) aufgesetzt und wird von der Frankfurt School of Finance and Management verwaltet. Der ISF ist ein Vehikel zur Implementierung des sog. Tripartite Agreement zwischen dem Insurance Development Forum (IDF), dem Umweltprogramm der Vereinten Nationen (UNDP) und dem BMZ.",
"geschaeftsjahr": "2025"
}
],
